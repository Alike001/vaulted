# Story Aeneid testnet
VITE_STORY_RPC=https://aeneid.storyrpc.io
VITE_CHAIN_ID=1315
# CDR Story-API REST node (confirm current value in the hackathon Discord)
# Local dev: hit the node directly over HTTP (below).
# Production (Vercel = HTTPS): set VITE_CDR_API_URL=/cdr-api so the browser calls
# a same-origin HTTPS path that vercel.json proxies to the HTTP node server-side.
# Direct HTTP from an HTTPS page is blocked by browsers (mixed content).
VITE_CDR_API_URL=http://172.192.41.96:1317
# Optional: block explorer base for linking vault tx hashes
VITE_EXPLORER_URL=
